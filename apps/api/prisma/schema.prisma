generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApiEnvironment {
  live
  sandbox
}

model Tenant {
  id                  String             @id @default(uuid())
  name                String
  slug                String             @unique
  plan                String             @default("free")
  monthlyOrderQuota   Int?
  createdAt           DateTime           @default(now())
  apiKeys             ApiKey[]
  products            Product[]
  carts               Cart[]
  orders              Order[]
  variants            ProductVariant[]
  webhookEndpoints    WebhookEndpoint[]
  outboxEvents        OutboxEvent[]
  organizations       Organization[]
  priceLists          PriceList[]
  featureFlags        FeatureFlag[]
}

model ApiKey {
  id          String         @id @default(uuid())
  tenantId    String
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyHash     String         @unique
  name        String
  environment ApiEnvironment @default(live)
  createdAt   DateTime       @default(now())
  revokedAt   DateTime?

  @@index([tenantId])
}

model Organization {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  priceListId String?
  priceList   PriceList? @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  members     OrganizationMember[]
  orders      Order[]

  @@unique([tenantId, slug])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("buyer")

  @@unique([organizationId, email])
}

model PriceList {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  createdAt DateTime @default(now())
  items     PriceListItem[]
  organizations Organization[]

  @@unique([tenantId, slug])
}

model PriceListItem {
  id          String    @id @default(uuid())
  priceListId String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceCents  Int
  currency    String    @default("EUR")

  @@unique([priceListId, variantId])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key       String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}

model Product {
  id          String             @id @default(uuid())
  tenantId    String
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime           @default(now())
  variants    ProductVariant[]
  embedding   ProductEmbedding?

  @@unique([tenantId, slug])
}

model ProductEmbedding {
  id        String   @id @default(uuid())
  tenantId  String
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  model     String   @default("text-embedding-3-small")
  dims      Int      @default(1536)
  values    Json
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model ProductVariant {
  id             String          @id @default(uuid())
  tenantId       String
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  priceCents     Int
  currency       String          @default("EUR")
  cartLines      CartLine[]
  orderLines     OrderLine[]
  priceListItems PriceListItem[]

  @@unique([tenantId, sku])
}

model Cart {
  id        String     @id @default(uuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  lines     CartLine[]
}

model CartLine {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int

  @@index([cartId])
}

model Order {
  id              String          @id @default(uuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organizationId  String?
  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  status          OrderStatus     @default(pending)
  /// Net goods before tax (minor units)
  netSubtotalCents Int?
  taxTotalCents   Int?
  taxCountry      String?
  taxRateBps      Int?
  totalCents      Int
  currency        String          @default("EUR")
  createdAt       DateTime        @default(now())
  lines           OrderLine[]
  events          OrderEvent[]
}

enum OrderStatus {
  pending
  confirmed
  cancelled
}

model OrderLine {
  id             String         @id @default(uuid())
  orderId        String
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  quantity       Int
  unitPriceCents Int

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(uuid())
  tenantId  String
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind      String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([tenantId])
}

model WebhookEndpoint {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  secret    String
  events    String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  deliveries OutboxDelivery[]

  @@index([tenantId])
}

model OutboxEvent {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  deliveries OutboxDelivery[]

  @@index([tenantId])
  @@index([createdAt])
}

enum DeliveryStatus {
  pending
  sent
  failed
}

model OutboxDelivery {
  id         String          @id @default(uuid())
  eventId    String
  event      OutboxEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status     DeliveryStatus  @default(pending)
  attempts   Int             @default(0)
  lastError  String?
  sentAt     DateTime?

  @@unique([eventId, endpointId])
  @@index([status])
}
